# PAW TRACK — optional real authentication (Supabase)
#
# 1. Create a project at https://supabase.com
# 2. Copy this file to `.env` and paste your keys from
#    Supabase Dashboard → Project Settings → API
# 3. Restart the dev server (npm run dev)
#
# Leave both values empty to keep the app in demo mode (one-click role login).
# `.env` is gitignored — never commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
