# PAW TRACK — shared database + real authentication (Supabase)
#
# Leave these empty and the app still runs: it uses local demo login and each
# browser keeps its own copy of the sample data.
#
# To make the data shared across every user and device:
#   1. Create a free project at https://supabase.com
#   2. Open SQL Editor → New query, paste the SQL from the app
#      (Settings → Database Schema → "Copy Supabase SQL Migration") and Run.
#   3. Copy `.env.example` to `.env` and paste your two keys from
#      Supabase Dashboard → Project Settings → API
#   4. Restart the dev server (npm run dev)
#
# `.env` is gitignored — never commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
